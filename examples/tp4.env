# Tensor-parallel 4, the release's only layout. Copy to ../.env and run
# ./start.sh. Uses only settings from ../.env.example; everything not set here
# follows the release defaults. Uncomment HOST and API_KEY together to serve
# other machines.
# HOST=0.0.0.0
# API_KEY=
# PORT=8000
# SERVED_MODEL_NAME=dsv41-flash
# MODELS_DIR=./models
# VLLM_ENGRAM_PLACEMENT=ram
# P2P=auto
